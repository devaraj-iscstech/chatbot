# API Keys (Choose one or more based on your LLM preference)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Embedding Model Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternative: EMBEDDING_MODEL=openai  # For OpenAI embeddings

# LLM Settings
LLM_PROVIDER=anthropic  # Options: openai, anthropic
LLM_MODEL=claude-3-sonnet-20240229  # or gpt-4, gpt-3.5-turbo

# Retrieval Settings
TOP_K_RETRIEVAL=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Re-ranking
ENABLE_RERANKING=true
TOP_K_RERANK=3
