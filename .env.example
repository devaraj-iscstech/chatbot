# API Keys (Choose one based on your LLM preference)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Embedding Model Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Alternative: EMBEDDING_MODEL=openai  # For OpenAI embeddings

# LLM Settings
LLM_PROVIDER=google  # Options: openai, anthropic, google, local
LLM_MODEL=gemini-pro  # or claude-3-sonnet-20240229, gpt-4, gpt-3.5-turbo

# Retrieval Settings
TOP_K_RETRIEVAL=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Re-ranking
ENABLE_RERANKING=true
TOP_K_RERANK=3
